{
  "name": "@atroui/monorepo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev --filter=@atroui/docs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "registry:sync": "node ./scripts/registry-sync.mjs",
    "registry:sync:check": "node ./scripts/registry-sync.mjs --check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk": "^1.32.0",
      "brace-expansion@1": "^1.1.21",
      "dompurify": "^3.4.16",
      "fast-uri": "^3.1.6",
      "hono": "^4.13.11",
      "ip-address": "^10.5.1",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "nanoid": "^3.3.18",
      "nodemailer": "^10.0.9",
      "postcss": "^8.5.23",
      "postcss-selector-parser": "^7.1.6",
      "proxy-addr": "^2.0.8",
      "qs": "^6.16.0",
      "sharp": "^0.35.4",
      "source-map-js": "^1.2.2",
      "undici": "^6.28.1"
    }
  }
}
