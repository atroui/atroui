{
  "name": "atroui",
  "version": "0.3.0",
  "description": "AtroUI - production React / Next.js component catalog via the shadcn registry, plus optional Host API handlers. Docs at https://www.atroui.com.",
  "license": "MIT",
  "homepage": "https://www.atroui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atroui/atroui.git"
  },
  "bugs": {
    "url": "https://github.com/atroui/atroui/issues"
  },
  "keywords": [
    "atroui",
    "react",
    "nextjs",
    "components",
    "ui",
    "design-system",
    "tailwind"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": {
      "types": "./src/globals.css.d.ts",
      "default": "./src/globals.css"
    },
    "./api/contact": "./src/api/contact.ts",
    "./api/waitlist": "./src/api/waitlist.ts",
    "./api/newsletter": "./src/api/newsletter.ts",
    "./api/generate": "./src/api/generate.ts",
    "./api/thumbnail": "./src/api/thumbnail.ts",
    "./api/scope": "./src/api/scope.ts",
    "./lib/*": "./src/lib/*",
    "./components/*": "./src/components/*",
    "./content/*": "./src/content/*",
    "./assets/*": "./assets/*"
  },
  "files": [
    "src",
    "assets",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "next-themes": "^0.4.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@ai-sdk/xai": "^3.0.0",
    "@base-ui/react": "^1.3.0",
    "@huggingface/inference": "^4.13.24",
    "@phosphor-icons/react": "^2.1.10",
    "@resvg/resvg-js": "^2.6.2",
    "ai": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.525.0",
    "motion": "^12.38.0",
    "nodemailer": "^9.0.1",
    "react-use-measure": "^2.1.7",
    "satori": "^0.29.0",
    "shadcn": "^4.1.2",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@atroui/typescript-config": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@types/mdx": "^2.0.14",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/sharp": "^0.32.0",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "next": "^15.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  }
}
