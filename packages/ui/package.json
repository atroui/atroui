{
  "name": "atroui",
  "version": "0.1.0",
  "description": "AtroUI — personal component catalog. Dark-first design system for production UI.",
  "license": "MIT",
  "homepage": "https://atroui.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/KOUSTAV2409/componentlib"
  },
  "bugs": {
    "url": "https://github.com/KOUSTAV2409/componentlib/issues"
  },
  "keywords": [
    "atroui",
    "react",
    "nextjs",
    "components",
    "ui",
    "design-system",
    "tailwind"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/globals.css",
    "./lib/*": "./src/lib/*",
    "./components/*": "./src/components/*",
    "./content/*": "./src/content/*"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "next-themes": "^0.4.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "motion": "^12.38.0",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@atroui/typescript-config": "workspace:*",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "next": "^15.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  }
}
