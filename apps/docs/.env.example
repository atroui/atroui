# PostHog (docs host only — required for install-copy + Host API funnels)
# Create a project at https://us.posthog.com → Project settings → Project API key
# Also set both on Vercel → atroui-docs → Environment Variables (Production + Preview)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Newsletter / waitlist (Resend). Copy to .env.local — never put real keys here.
# Segment ID: Audience → Segments → atrouiupdates
RESEND_API_KEY=re_xxxxxxxx
RESEND_AUDIENCE_ID=
RESEND_SEGMENT_ID=
