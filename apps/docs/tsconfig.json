{
  "extends": "@atroui/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "atroui": ["../../packages/ui/src/index.ts"],
      "atroui/*": ["../../packages/ui/src/*"]
