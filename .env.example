# AtroUI / host app environment
# Copy to .env.local in the consuming Next.js app (or apps/docs for local demos).

# --- Site / brand overrides (optional) ---
NEXT_PUBLIC_SITE_URL=https://www.atroui.com
NEXT_PUBLIC_SITE_NAME=AtroUI
NEXT_PUBLIC_SITE_DOMAIN=atroui.com
NEXT_PUBLIC_SITE_EMAIL=hello@iamk.xyz
NEXT_PUBLIC_CALENDLY_URL=

# --- Analytics (optional) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Email (contact / newsletter / waitlist host APIs) ---
# Prefer Resend or SMTP (Gmail). Production should set one of these.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_PASS=   # alias for SMTP_PASSWORD
SMTP_SECURE=false

# --- Rate limiting (optional shared store for multi-instance / Vercel) ---
# Default is in-memory (fine for local + single instance).
# Paste Upstash Redis REST or Vercel KV to share limits across instances.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=          # Vercel KV alias (same REST protocol)
# KV_REST_API_TOKEN=

# --- AI / image generation (OG + thumbnail + scope host APIs) ---
# AtroUI never ships keys. Set these in YOUR app only.
HUGGINGFACE_API_KEY=
# HUGGINGFACE_IMAGE_MODEL=
# HUGGINGFACE_IMAGE_STEPS=
# HUGGINGFACE_IMAGE_GUIDANCE=
GEMINI_API_KEY=
# GOOGLE_AI_KEY=        # alias
# GOOGLE_AI_API_KEY=    # alias
XAI_API_KEY=            # optional: scope LLM + thumbnail Pro pipeline
# XAI_MODEL=

# --- Ops ---
REVALIDATE_SECRET=
INDEX_NOW_KEY=
